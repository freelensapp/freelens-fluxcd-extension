{
  // Ignore mismatch for Biome version to make Renovate updates without error
  // trunk-ignore(biome/deserialize)
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "type": false
              },
              ":NODE:",
              ":BLANK_LINE:",
              "@freelensapp/**",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "files": {
    // pnpm writes its own lockfile and workspace file, and Trunk rewrites its
    // own .trunk/trunk.yaml on every trunk upgrade.
    "includes": [
      "**",
      "!**/.trunk/**",
      "!**/build/**",
      "!**/dist/**",
      "**/build/*.{js,cjs,mjs}",
      "!**/pnpm-lock.yaml",
      "!**/pnpm-workspace.yaml"
    ]
  },
  "formatter": {
    "attributePosition": "auto",
    "bracketSpacing": true,
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "useEditorconfig": true
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "attributePosition": "auto",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noRedundantRoles": "off"
      },
      "complexity": {
        // should be error later
        "noBannedTypes": "off",
        "noUselessConstructor": "off",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error"
      },
      "correctness": {
        "noInvalidUseBeforeDeclaration": "error",
        // should be error later
        "noUnusedVariables": "off",
        "useExhaustiveDependencies": "off"
      },
      "nursery": {
        // Markdown
        "useConsistentHeadingLevel": "error",
        "useFencedCodeLanguage": "error",
        "useSingleTopLevelHeading": "error"
      },
      "preset": "none",
      "style": {
        "noNamespace": "error",
        // should be error later
        "noParameterAssign": "off",
        "useArrayLiterals": "off",
        "useAsConstAssertion": "error",
        "useBlockStatements": "off",
        "useNamingConvention": {
          "level": "off",
          "options": {
            "strictCase": false
          }
        },
        "useNodejsImportProtocol": "error",
        // should be error later
        "useTemplate": "off"
      },
      "suspicious": {
        "noEmptyInterface": "off",
        // should be error later
        "noExplicitAny": "off",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error",
        // should be error later
        "noUnsafeDeclarationMerging": "off",
        "useNamespaceKeyword": "error"
      }
    }
  },
  // Every path in an override starts with `**/`: Trunk runs Biome from a
  // sandbox outside the repository, where a path anchored at the repository
  // root matches no file and the override silently does nothing.
  "overrides": [
    {
      // Test-only modules, kept out of the extension's code. No tsconfig
      // declares the Vitest globals, so test code imports them from "vitest".
      // The testing helpers of React resolve from every program too, and they
      // build and pass the unit tests, but the host runs the production build
      // of React, which leaves `act` out, so they throw only in Freelens. The
      // next override lifts the rule for tests and test support.
      "includes": ["**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vitest": "Vitest is for test code only",
                  "react": {
                    "importNames": ["act"],
                    "message": "React.act is for test code only: the production build of React, which Freelens runs, does not have it, so the call throws in the host"
                  },
                  "react-dom/test-utils": "react-dom/test-utils is for test code only: its act delegates to React.act, which the production build of React does not have, so the call throws in the host"
                },
                "patterns": [
                  {
                    "group": ["@testing-library/**"],
                    "message": "Testing Library is for test code only: the act of @testing-library/react delegates to React.act, which the production build of React does not have, so the call throws in the host"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Tests and test support, which import their Vitest functions from
      // "vitest" explicitly. The integration tests run inside a Freelens
      // checkout, under its Vitest.
      "includes": ["**/integration/**", "**/src/**/*.test.*", "**/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      // Renderer and common code, as the extension migration guide recommends:
      // a Node builtin import belongs in the main entry point only. Tests are
      // left out, as they are of the renderer and common programs.
      "includes": ["**/src/common/**", "**/src/renderer/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "yaml": {
    "formatter": {
      // Flow sequences stay [a, b], as yamlfmt left them; the global
      // bracketSpacing is meant for JavaScript objects.
      "bracketSpacing": false
    }
  }
}
