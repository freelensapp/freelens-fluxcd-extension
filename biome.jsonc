{
  // Ignore mismatch for Biome version to make Renovate updates without error
  // trunk-ignore(biome/deserialize)
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "type": false
              },
              ":NODE:",
              ":BLANK_LINE:",
              "@freelensapp/**",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "files": {
    "includes": ["**", "!**/.trunk/**", "!**/build/**", "!**/dist/**", "**/build/*.{js,cjs,mjs}"]
  },
  "formatter": {
    "attributePosition": "auto",
    "bracketSpacing": true,
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "useEditorconfig": true
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "attributePosition": "auto",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noRedundantRoles": "off"
      },
      "complexity": {
        // should be error later
        "noBannedTypes": "off",
        "noUselessConstructor": "off",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error"
      },
      "correctness": {
        "noInvalidUseBeforeDeclaration": "error",
        // should be error later
        "noUnusedVariables": "off",
        "useExhaustiveDependencies": "off"
      },
      "preset": "none",
      "style": {
        "noNamespace": "error",
        // should be error later
        "noParameterAssign": "off",
        "useArrayLiterals": "off",
        "useAsConstAssertion": "error",
        "useBlockStatements": "off",
        "useNamingConvention": {
          "level": "off",
          "options": {
            "strictCase": false
          }
        },
        "useNodejsImportProtocol": "error",
        // should be error later
        "useTemplate": "off"
      },
      "suspicious": {
        "noEmptyInterface": "off",
        // should be error later
        "noExplicitAny": "off",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error",
        // should be error later
        "noUnsafeDeclarationMerging": "off",
        "useNamespaceKeyword": "error"
      }
    }
  },
  // Every path in an override starts with `**/`: Trunk runs Biome from a
  // sandbox outside the repository, where a path anchored at the repository
  // root matches no file and the override silently does nothing.
  "overrides": [
    {
      // No tsconfig declares the Vitest globals, so test code imports them
      // from "vitest". The module resolves from every program, so only this
      // rule keeps it out of the extension's code; the next override lifts it
      // for tests and test support.
      "includes": ["**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vitest": "Vitest is for test code only"
                }
              }
            }
          }
        }
      }
    },
    {
      // Tests and test support, which import their Vitest functions from
      // "vitest" explicitly. The integration tests run inside a Freelens
      // checkout, under its Vitest.
      "includes": ["**/integration/**", "**/src/**/*.test.*", "**/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      // Renderer and common code, as the extension migration guide recommends:
      // a Node builtin import belongs in the main entry point only. Tests are
      // left out, as they are of the renderer and common programs.
      "includes": ["**/src/common/**", "**/src/renderer/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
